{{-- resources/views/pages/dashboard.edge --}}
@layout()
  <div class="dashboard-wrapper">
    <header class="dashboard-header">
      <div class="header-title-block">
        <div class="user-greeting">
          Hello,
          <span class="user-name">{{ user.profileName }}</span>
          👋
        </div>
        <h2>NairaBook Ledger</h2>
        <p class="header-subtext">
          Real-time financials and inventory processed directly via WhatsApp voice notes.
        </p>
      </div>

      <div class="actions-deck"><span class="status-badge">🟢 Live Connection</span></div>
    </header>

    <section class="metrics-grid">
      <div class="metric-card">
        <span class="metric-label">Sales Today</span>
        <div class="metric-value val-sales">
          ₦{{
            metrics.totalSalesToday.toLocaleString('en-NG', {
              minimumFractionDigits: 2,
            })
          }}
        </div>
      </div>

      <div class="metric-card">
        <span class="metric-label">Expenses Today</span>
        <div class="metric-value val-expenses">
          ₦{{
            metrics.totalExpensesToday.toLocaleString('en-NG', {
              minimumFractionDigits: 2,
            })
          }}
        </div>
      </div>

      <div class="metric-card">
        <span class="metric-label">Today's Net Flow</span>
        <div
          class="metric-value {{ metrics.netProfitToday >= 0 ? 'val-profit-pos' : 'val-profit-neg' }}"
        >
          ₦{{
            metrics.netProfitToday.toLocaleString('en-NG', {
              minimumFractionDigits: 2,
            })
          }}
        </div>
      </div>

      <div class="metric-card">
        <span class="metric-label">Money Outside (All Time)</span>
        <div class="metric-value val-debt">
          ₦{{
            metrics.totalOutstandingDebt.toLocaleString('en-NG', {
              minimumFractionDigits: 2,
            })
          }}
        </div>
      </div>
    </section>

    <div class="insights-section">
      <section class="panel-block">
        <div class="panel-header">
          <h3>Recent Voice Activity Logs</h3>
          <p class="header-subtext">
            5 latest events captured and parsed from your WhatsApp voice notes
          </p>
        </div>

        <div class="ledger-table-container">
          @if(recentTransactions.length === 0)
            <div class="empty-state">
              No transactions logged today yet. Speak to our WhatsApp bot to update your business metrics! 🎙️
            </div>
          @else
            <table class="ledger-table">
              <thead>
                <tr>
                  <th style="width: 15%;">Type</th>
                  <th style="width: 60%;">Details / Description</th>
                  <th style="width: 25%; text-align: right;">Amount</th>
                </tr>
              </thead>
              <tbody>
                @each(trx in recentTransactions)
                  <tr>
                    <td>
                      <span
                        class="type-badge {{ trx.type === 'sale' ? 'badge-sale' : 'badge-expense' }}"
                      >
                        {{ trx.type }}
                      </span>
                    </td>
                    <td>
                      <p class="item-name">{{ trx.itemName || 'Business Action' }}</p>
                      <p class="item-time">{{ trx.createdAt.toFormat('hh:mm a') }}</p>
                    </td>
                    <td class="item-amount">
                      ₦{{
                        trx.amount.toLocaleString('en-NG', {
                          minimumFractionDigits: 2,
                        })
                      }}
                    </td>
                  </tr>
                @end
              </tbody>
            </table>
          @end
        </div>
      </section>

      <section class="panel-block">
        <div class="panel-header">
          <h3 style="color: var(--clr-rose);">Inventory Stockouts</h3>
          <p class="header-subtext">Product stock requiring urgent update</p>
        </div>

        <div class="alert-list">
          @if(stockAlerts.length === 0)
            <div
              class="empty-state"
              style="padding: 20px; border: 1px dashed var(--clr-emerald); background-color: var(--clr-emerald-light); color: var(--clr-emerald); border-radius: 12px; font-weight: 600;"
            >
              ✨ All balances healthy! No actions needed.
            </div>
          @else
            @each(product in stockAlerts)
              <div class="alert-item">
                <div>
                  <h4 class="alert-product-name">{{ product.name }}</h4>
                  <p class="alert-product-sub">Requires urgent replenishment</p>
                </div>
                <div class="alert-counter">{{ product.currentStock }}</div>
              </div>
            @end
          @end
        </div>
      </section>
    </div>

    <div class="secondary-grid">
      <section class="panel-block">
        <div class="panel-header">
          <h3>Customer Debt Accounts</h3>
          <p class="header-subtext">Active books tracking outstanding debts</p>
        </div>
        <div class="ledger-table-container">
          @if(!activeDebtors || activeDebtors.length === 0)
            <div class="empty-state">No outstanding customer balances found on your books. 🎉</div>
          @else
            <table class="ledger-table">
              <thead>
                <tr>
                  <th>Customer</th>
                  <th>Status</th>
                  <th style="text-align: right;">Outstanding Balance</th>
                </tr>
              </thead>
              <tbody>
                @each(debtor in activeDebtors)
                  <tr>
                    <td>
                      <p class="item-name">{{ debtor.customerName }}</p>
                      <p class="item-time">Item: {{ debtor.itemDetails }}</p>
                    </td>
                    <td>
                      <span
                        class="type-badge {{
                          debtor.status === 'unpaid'
                            ? 'badge-debt-unpaid'
                            : 'badge-debt-partial'
                        }}"
                      >
                        {{ debtor.status }}
                      </span>
                    </td>
                    <td class="item-amount" style="color: var(--clr-amber);">
                      ₦{{
                        debtor.remainingBalance.toLocaleString('en-NG', {
                          minimumFractionDigits: 2,
                        })
                      }}
                    </td>
                  </tr>
                @end
              </tbody>
            </table>
          @end
        </div>
      </section>

      <section class="panel-block">
        <div class="panel-header">
          <h3>Inventory Log</h3>
          <p class="header-subtext">Active tracking of stock states across all products</p>
        </div>
        <div class="ledger-table-container">
          @if(!allProducts || allProducts.length === 0)
            <div class="empty-state">
              No products found in your catalog. Say "add 20 bags of rice for 2 million Naira" via WhatsApp to start! 📦
            </div>
          @else
            <table class="ledger-table">
              <thead>
                <tr>
                  <th>Product Details</th>
                  <th>Stock Status</th>
                  <th style="text-align: right;">Current Inventory</th>
                </tr>
              </thead>
              <tbody>
                @each(prod in allProducts)
                  <tr>
                    <td>
                      <p class="item-name">{{ prod.name }}</p>
                      <p class="item-time">
                        Last updated:
                        {{ prod.updatedAt?.toFormat('LLL dd, yyyy') || 'Recent' }}
                      </p>
                    </td>
                    <td>
                      @if(prod.currentStock <= 0)
                        <span class="stock-indicator indicator-empty">Stockout</span>
                      @elseif(prod.currentStock <= 5)
                        <span class="stock-indicator indicator-low">Low Stock</span>
                      @else
                        <span class="stock-indicator indicator-ok">Healthy</span>
                      @end
                    </td>
                    <td class="item-amount" style="color: var(--clr-slate-900);">
                      {{ prod.currentStock }}
                      units
                    </td>
                  </tr>
                @end
              </tbody>
            </table>
          @end
        </div>
      </section>
    </div>
    <section id="statement-ledger" class="panel-block" style="margin-top: 25px;">
      {{-- NB: The id "#statement-ledger" is to anchor the page to the particular section after the server full-page reload on clicking a filter or nav button --}}
      <div class="report-header-block">
        <div>
          <h3>Transaction History & Statements</h3>
          <p class="header-subtext">
            View, filter, and export your recorded sales and expenses by date range.
          </p>
        </div>

        <div class="filter-group">
          <a
            href="?range=24h#statement-ledger"
            class="filter-pill {{ currentRange === '24h' ? 'active' : '' }}"
          >
            24 Hours
          </a>
          <a
            href="?range=1wk#statement-ledger"
            class="filter-pill {{ currentRange === '1wk' ? 'active' : '' }}"
          >
            1 Week
          </a>
          <a
            href="?range=1mo#statement-ledger"
            class="filter-pill {{ currentRange === '1mo' ? 'active' : '' }}"
          >
            1 Month
          </a>
          <a
            href="?range=all#statement-ledger"
            class="filter-pill {{ currentRange === 'all' ? 'active' : '' }}"
          >
            All Time
          </a>
        </div>

        <a href="?export=ledger&range={{ currentRange }}" class="export-btn">
          📥 Download Filtered Statement (.csv)
        </a>
      </div>

      <div class="ledger-table-container">
        @if(reportTransactions.isEmpty)
          <div class="empty-state">
            No records found matching the selected timeframe criteria. 🗓️
          </div>
        @else
          <table class="ledger-table">
            <thead>
              <tr>
                <th style="width: 25%;">Timestamp</th>
                <th style="width: 15%;">Classification</th>
                <th style="width: 40%;">Description</th>
                <th style="width: 20%; text-align: right;">Cash Impact</th>
              </tr>
            </thead>
            <tbody>
              @each(trx in reportTransactions)
                <tr>
                  <td class="item-time" style="font-size: 13px;">
                    {{ trx.createdAt.toFormat('LLL dd, yyyy — hh:mm a') }}
                  </td>
                  <td>
                    <span
                      class="type-badge {{ trx.type === 'sale' ? 'badge-sale' : 'badge-expense' }}"
                    >
                      {{ trx.type }}
                    </span>
                  </td>
                  <td class="item-name">{{ trx.itemName }}</td>
                  <td
                    class="item-amount {{ trx.type === 'sale' ? 'impact-positive' : 'impact-negative' }}"
                  >
                    {{ trx.type === 'sale' ? '+' : '-' }}₦{{
                      trx.amount.toLocaleString('en-NG', {
                        minimumFractionDigits: 2,
                      })
                    }}
                  </td>
                </tr>
              @end
            </tbody>
          </table>

          <footer class="pagination-container">
            <div class="pagination-meta">
              Showing page
              <strong>{{ reportTransactions.currentPage }}</strong>
              of
              <strong>{{ reportTransactions.lastPage }}</strong>
              (Total:
              {{ reportTransactions.total }}
              records)
            </div>

            <div class="pagination-nav">
              <!--Previous Button Link-->
              <a
                href="?range={{ currentRange }}&page={{ reportTransactions.currentPage - 1 }}#statement-ledger"
                class="pagination-link {{ reportTransactions.currentPage === 1 ? 'disabled' : '' }}"
              >
                ← Previous
              </a>
              <!--Next Button Link-->
              <a
                href="?range={{ currentRange }}&page={{ reportTransactions.currentPage + 1 }}#statement-ledger"
                class="pagination-link {{ !reportTransactions.hasMorePages ? 'disabled' : '' }}"
              >
                Next →
              </a>
            </div>
          </footer>
        @end
      </div>
    </section>
  </div>
@end
