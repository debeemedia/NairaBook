{{-- resources/views/pages/dashboard.edge --}}
@layout()
  {{--
    <div class="hero">
    <h1>Welcome to your Dashboard!</h1>
    <p>
    View your transactions, inventory, customers and credit.
    </p>
    </div>
  --}}
  <div class="min-h-screen bg-slate-50 text-slate-800 pb-12">
    <header
      class="bg-white border-b border-slate-100 px-4 py-5 sm:px-6 sticky top-0 z-10 shadow-sm"
    >
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <div>
          <span
            class="text-xs font-bold uppercase tracking-wider text-green-600 bg-green-50 px-2.5 py-1 rounded-full"
          >
            Live Ledger
          </span>
          <h1 class="text-xl font-black text-slate-900 mt-1">NairaBook Dashboard 📊</h1>
        </div>
        <div class="text-right hidden sm:block">
          <p class="text-xs text-slate-400">Business Summary</p>
          <p class="text-sm font-semibold text-slate-600">Today</p>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 mt-6 space-y-6">
      <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <div class="bg-white p-4 sm:p-6 rounded-2xl border border-slate-100 shadow-sm">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Sales Today</span>
          <h3 class="text-lg sm:text-2xl font-black text-slate-900 mt-1">
            ₦{{
              metrics.totalSalesToday.toLocaleString('en-NG', {
                minimumFractionDigits: 2,
              })
            }}
          </h3>
        </div>

        <div class="bg-white p-4 sm:p-6 rounded-2xl border border-slate-100 shadow-sm">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">
            Money Outside
          </span>
          <h3 class="text-lg sm:text-2xl font-black text-amber-600 mt-1">
            ₦{{
              metrics.totalOutstandingDebt.toLocaleString('en-NG', {
                minimumFractionDigits: 2,
              })
            }}
          </h3>
        </div>

        <div class="bg-white p-4 sm:p-6 rounded-2xl border border-slate-100 shadow-sm">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Expenses</span>
          <h3 class="text-lg sm:text-2xl font-black text-rose-600 mt-1">
            ₦{{
              metrics.totalExpensesToday.toLocaleString('en-NG', {
                minimumFractionDigits: 2,
              })
            }}
          </h3>
        </div>

        <div class="bg-white p-4 sm:p-6 rounded-2xl border border-slate-100 shadow-sm">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">
            Net Cash Flow
          </span>
          <h3
            class="text-lg sm:text-2xl font-black mt-1 {{ metrics.netProfitToday >= 0 ? 'text-green-600' : 'text-rose-700' }}"
          >
            ₦{{
              metrics.netProfitToday.toLocaleString('en-NG', {
                minimumFractionDigits: 2,
              })
            }}
          </h3>
        </div>
      </section>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <section
          class="lg:col-span-2 bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden"
        >
          <div class="p-5 border-b border-slate-100">
            <h2 class="font-black text-slate-900 text-base">Recent Voice Logs 📝</h2>
            <p class="text-xs text-slate-400">Latest business actions synced via WhatsApp</p>
          </div>

          <div class="divide-y divide-slate-100 overflow-x-auto">
            @if(recentTransactions.length === 0)
              <p class="text-sm text-slate-400 p-6 text-center">
                No transactions recorded today yet. Speak into WhatsApp to log entries! 🎙️
              </p>
            @else
              <table class="w-full text-left border-collapse min-w-[500px]">
                <thead>
                  <tr
                    class="bg-slate-50 text-[10px] uppercase font-bold tracking-wider text-slate-400 border-b border-slate-100"
                  >
                    <th class="py-3 px-5">Type</th>
                    <th class="py-3 px-5">Details</th>
                    <th class="py-3 px-5 text-right">Amount</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                  @each(trx in recentTransactions)
                    <tr class="hover:bg-slate-50/50 transition-colors">
                      <td class="py-3.5 px-5">
                        <span
                          class="inline-block px-2 py-0.5 text-xs font-bold rounded-full {{
                            trx.type === 'sale'
                              ? 'bg-green-50 text-green-700'
                              : 'bg-rose-50 text-rose-700'
                          }}"
                        >
                          {{ trx.type }}
                        </span>
                      </td>
                      <td class="py-3.5 px-5">
                        <p class="font-medium text-slate-800 capitalize">
                          {{ trx.itemName || 'Business Activity' }}
                        </p>
                        <p class="text-xs text-slate-400">
                          {{ trx.createdAt.toFormat('hh:mm a') }}
                        </p>
                      </td>
                      <td class="py-3.5 px-5 text-right font-bold text-slate-900">
                        ₦{{ trx.amount.toLocaleString('en-NG') }}
                      </td>
                    </tr>
                  @end
                </tbody>
              </table>
            @end
          </div>
        </section>

        <section class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5 space-y-4">
          <div>
            <h2 class="font-black text-slate-900 text-base">Inventory Critical Alerts ⚠️</h2>
            <p class="text-xs text-slate-400">Items sold down to negative balances</p>
          </div>

          <div class="space-y-3">
            @if(stockAlerts.length === 0)
              <div
                class="text-center py-8 bg-green-50/30 border border-dashed border-green-100 rounded-xl p-4"
              >
                <p class="text-sm font-semibold text-green-700">All balances healthy! ✨</p>
                <p class="text-xs text-slate-400 mt-0.5">No shadow sales tracked.</p>
              </div>
            @else
              @each(product in stockAlerts)
                <div
                  class="flex justify-between items-center bg-rose-50/60 border border-rose-100/70 p-3.5 rounded-xl"
                >
                  <div>
                    <h4 class="font-bold text-slate-800 capitalize text-sm">{{ product.name }}</h4>
                    <p class="text-[11px] text-rose-600 font-medium mt-0.5">
                      Requires restock cataloging
                    </p>
                  </div>
                  <div class="text-right">
                    <span
                      class="inline-block px-2.5 py-1 bg-rose-600 text-white font-black text-xs rounded-lg"
                    >
                      {{ product.currentStock }}
                    </span>
                  </div>
                </div>
              @end
            @end
          </div>
        </section>
      </div>
    </main>
  </div>
@end
